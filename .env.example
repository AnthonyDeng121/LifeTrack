# Copy the values into your terminal environment. This file is documentation only.
# Never put real passwords or API keys in this file or commit them to Git.

# Backend / MySQL
DB_URL=jdbc:mysql://localhost:3306/lifetrack?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Use a random value with at least 32 characters outside the test environment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=86400000

# Optional Python AI service
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4-flash
AI_TEMPERATURE=0.3
